# Rolust — 環境変数の雛形
#
# NFR-3: AWS の認証情報・API キー・Basic 認証の資格情報を**このファイルに書かない**。
#   - AWS 認証情報は Lambda 実行ロール（本番）またはローカルの AWS 認証情報チェーンから取得する
#   - 管理画面の Basic 認証資格情報は SSM Parameter Store の SecureString に置く
#     （パラメータ名は packages/edge-auth/src/index.ts の定数。Lambda@Edge は環境変数を持てない）
#
# このファイルをコピーして `.env` を作る。`.env` は .gitignore 済み。

# --- packages/api (Lambda) ---
# DynamoDB の状態テーブルと申請テーブルの名前（Issue #36 で 1 本から 2 本に分けた）。
# 未設定、または同じ名前だと API は起動時に fail fast する。廃止した ROLUST_TABLE_NAME が残っていても落ちる。
ROLUST_STATE_TABLE_NAME=rolust-state
ROLUST_CHANGE_REQUEST_TABLE_NAME=rolust-change-requests
# 管理対象 IAM ロールを示すタグ。Terraform の managed_tag_key / managed_tag_value と
# 同じ値である必要がある（infra/lambda.tf が本番の Lambda へ同じ値を渡す）。
# **どちらも必須**。タグ方式に「タグなし」という安全な既定値は無いため、
# 未設定だと API は起動時に fail fast する。
ROLUST_MANAGED_TAG_KEY=rolust:managed
ROLUST_MANAGED_TAG_VALUE=true
# Lambda では実行環境が設定するため通常は不要。ローカル実行時のみ指定する。
AWS_REGION=ap-northeast-1

# --- packages/web (Vite) ---
# API のベース URL。CloudFront 経由の同一オリジン配信では既定の "/api" で足りるため、
# ローカル開発で別オリジンの API を叩くときだけ設定する。
# VITE_ROLUST_API_BASE_URL=http://localhost:3000/api
