# 個人の値の雛形。`.local/rolust.env` に写して値を入れ、`source .local/rolust.env` で読み込む。
# `.local/rolust.env` は gitignore されている（コミットされない）。値をリポジトリに書かない。
#
# `aws` も `terraform` も `.env` を自動では読まないので、シェルの環境変数が正になる。
#
# Claude Code のセッションでは、`source` の代わりに、gitignore 済みの `.claude/settings.local.json` の
# `"env": { "AWS_PROFILE": "<自分のプロファイル>" }` でも Bash ツールへ渡る（Issue #176 で実測）。
# 注意: 実行中のセッションにも反映され、ファイルを消しても、そのセッションの間は値が残る。
# 一時的な値を試したときは、セッションを開き直す（ユニットテストは AWS_PROFILE が残っていると壊れる）。

# --- 共通 ---
export AWS_PROFILE=            # terraform・aws を使うときのプロファイル（デプロイ先の管理者）
export AWS_REGION=             # デプロイ先のリージョン

# --- 統合テスト（`ROLUST_INTEGRATION=1 npm run test:integration`）---
# DEPLOY: Rolust のデプロイ先アカウント。TARGET1: クロスアカウントの確認に使うターゲットアカウント。
# ACCOUNT は 12 桁の数字。書き込みの前に、プロファイルのアカウントと一致するかを STS で照合する。
export ROLUST_INTEGRATION_DEPLOY_PROFILE=
export ROLUST_INTEGRATION_DEPLOY_ACCOUNT=
export ROLUST_INTEGRATION_TARGET1_PROFILE=
export ROLUST_INTEGRATION_TARGET1_ACCOUNT=

# 管理対象タグ（`infra/variables.tf` の既定。本番で変えているときだけ合わせる）
# export ROLUST_INTEGRATION_MANAGED_TAG_KEY=rolust:managed
# export ROLUST_INTEGRATION_MANAGED_TAG_VALUE=true
